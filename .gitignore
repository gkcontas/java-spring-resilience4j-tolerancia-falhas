# Gradle
.gradle/
build/

# Java
*.class
*.war
*.log
hs_err_pid*

# Jars: ignora todos, MENOS o wrapper do Gradle.
# A ordem importa — no .gitignore vale o ULTIMO padrao que casa, então a negação
# precisa vir DEPOIS do "*.jar". Invertido, o wrapper fica fora do repositório e o
# ./gradlew quebra em qualquer clone.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
bin/

# OS
.DS_Store
Thumbs.db

# Documentos internos de planejamento
*.md
!README.md
